{
  "manifest_version": 3,
  "name": "Droppr — Price Tracker",
  "version": "1.0.0",
  "description": "Track prices from the page you're browsing and get notified when they drop.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Droppr",
    "default_icon": { "16": "icons/droppr-16.png", "32": "icons/droppr-32.png" }
  },
  "icons": { "16": "icons/droppr-16.png", "32": "icons/droppr-32.png", "48": "icons/droppr-48.png", "128": "icons/droppr-128.png" },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["activeTab", "alarms", "notifications", "scripting", "storage", "tabs"],
  "optional_host_permissions": ["http://*/*", "https://*/*"]
}
